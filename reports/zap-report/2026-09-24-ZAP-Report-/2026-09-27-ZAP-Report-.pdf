					<div class="summaryChartWrapper">
						<canvas id="summaryChart" width="550" height="300"></canvas>
						<script type="text/javascript">
                            /*<![CDATA[*/
                            var title = "Alert Chart";
                            var labels = [
                            "High",
                            "Medium",
                            "Low",
                            "Informational"];
                            var data = [
                            null,
                            null,
                            1,
                            2];
                            /*]]>*/

                            const fontColor = getComputedStyle(document
                                    .querySelector('.chart-text-color')).color;

                            var options = {
                                responsive : true,
                                legend : {
                                    position : 'bottom',
                                    labels : {
                                        fontColor : fontColor,
                                        padding : 30
                                    }
                                }
                            }

                            const chartHigh = getComputedStyle(document
                                    .querySelector('.risk-3-chart')).backgroundColor;
                            const chartMed = getComputedStyle(document
                                    .querySelector('.risk-2-chart')).backgroundColor;
                            const chartLow = getComputedStyle(document
                                    .querySelector('.risk-1-chart')).backgroundColor;
                            const chartInfo = getComputedStyle(document
                                    .querySelector('.risk-0-chart')).backgroundColor;

                            new Chart(document.getElementById("summaryChart"),
                                    {
                                        type : "doughnut",
                                        data : {
                                            labels : labels,
                                            datasets : [ {
                                                label : title,
                                                data : data,
                                                fill : false,
                                                backgroundColor : [ chartHigh,
                                                        chartMed, chartLow,
                                                        chartInfo ],
                                                borderWidth : 0
                                            } ]
                                        },
                                        options : options
                                    });
                        </script>
